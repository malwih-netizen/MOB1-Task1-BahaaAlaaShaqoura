<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".Task1App"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Task1">

        <!-- Home screen: quick access to the 5 apps + Light/Dark toggle -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BirthdayCardActivity"
            android:label="@string/birthday_card_name" />
        <activity
            android:name=".TaskDoneActivity"
            android:label="@string/task_done_name" />
        <activity
            android:name=".QuadrantActivity"
            android:label="@string/quadrant_name" />
        <activity
            android:name=".ArticleActivity"
            android:label="@string/article_name" />
        <activity
            android:name=".BusinessCardActivity"
            android:label="@string/business_card_name"
            android:theme="@style/Theme.Task1.BusinessCard" />
    </application>

</manifest>
